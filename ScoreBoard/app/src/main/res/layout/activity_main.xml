<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/title"
        android:textStyle="bold"
        android:textSize="28sp" />

    <Button
        android:id="@+id/btnWhistle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="@string/btn_whistle" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/team_a_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/tvNameA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/team_a_name"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvScoreA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="@string/zero"
                android:textSize="64sp" />

            <Button
                android:id="@+id/btnA3"
                style="@style/ScoreButton"
                android:backgroundTint="@color/team_a_button"
                android:text="@string/plus_3" />

            <Button
                android:id="@+id/btnA2"
                style="@style/ScoreButton"
                android:backgroundTint="@color/team_a_button"
                android:text="@string/plus_2" />

            <Button
                android:id="@+id/btnA1"
                style="@style/ScoreButton"
                android:backgroundTint="@color/team_a_button"
                android:text="@string/plus_1" />

            <Button
                android:id="@+id/btnAn1"
                style="@style/ScoreButton"
                android:backgroundTint="@color/team_a_button_reducer"
                android:text="@string/minus_1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/team_b_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvNameB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/team_b_name"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvScoreB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="@string/zero"
                android:textSize="64sp" />

            <Button
                android:id="@+id/btnB3"
                style="@style/ScoreButton"
                android:backgroundTint="@color/team_b_button"
                android:text="@string/plus_3" />

            <Button
                android:id="@+id/btnB2"
                style="@style/ScoreButton"
                android:backgroundTint="@color/team_b_button"
                android:text="@string/plus_2" />

            <Button
                android:id="@+id/btnB1"
                style="@style/ScoreButton"
                android:backgroundTint="@color/team_b_button"
                android:text="@string/plus_1" />

            <Button
                android:id="@+id/btnBn1"
                style="@style/ScoreButton"
                android:backgroundTint="@color/team_b_button_reducer"
                android:text="@string/minus_1" />
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:backgroundTint="@color/btn_reset"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:orientation="horizontal">
    <Button
        android:id="@+id/btnReset"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/btn_reset"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/reset"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />
        <Button
            android:id="@+id/btnEnd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/btn_reset"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/end_game"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>


</LinearLayout>